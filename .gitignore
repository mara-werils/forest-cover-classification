# The raw CSV is downloaded by the code (see README). Versioned: the 1,000-row sample
# and the 7 MB Parquet file, so the app and prediction work right after cloning.
data/raw/
data/processed/*
!data/processed/covtype.parquet
# Only the selected model is versioned (40 MB) so prediction works right after cloning.
models/*.joblib
!models/best_model.joblib
# Local artefacts
reports/prediction_history.json
reports/full_run.log
reports/histgb_rerun.log
reports/robustness_run.log
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.venv/
venv/
.ipynb_checkpoints/
~$*
